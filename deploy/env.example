# 운영 서버의 ~/fight-club/.env 로 복사해 고쳐 쓴다 (deploy/README.md) — 이 파일에는 비밀번호를 적지 않는다

# 게임 주소(도메인). 화면과 게임 서버를 같은 주소로 내보낸다. 예: fightclub.duckdns.org
SITE=fightclub.duckdns.org
# 게임 서버에 들어올 수 있는 페이지 출처 — 위 SITE에 https:// 를 붙인 값과 같아야 한다
ALLOWED_ORIGINS=https://fightclub.duckdns.org

# /admin 운영 화면 비밀번호 (사용자 admin, 12자 이상). 비워 두면 /admin을 열지 않는다
ADMIN_PASSWORD=

# 로그 수준 (info · debug · warn)
LOG_LEVEL=info

# 부하 시험을 보내는 컴퓨터의 IP를 IP 제한에서 뺄 때만 적는다 (시험 뒤 지운다). 예: 203.0.113.7
IP_LIMIT_EXEMPT=
